generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Program {
  id            String         @id @default(uuid())
  name          String         @unique
  createdAt     DateTime       @default(now())
  announcements Announcement[]
  departments   Department[]
  students      Student[]
}

model Department {
  id            String         @id @default(uuid())
  name          String
  createdAt     DateTime       @default(now())
  programId     String
  announcements Announcement[]
  program       Program        @relation(fields: [programId], references: [id])
  faculties     Faculty[]
  students      Student[]

  @@unique([name, programId])
}

model Faculty {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  password      String
  createdAt     DateTime       @default(now())
  isFirstLogin  Boolean        @default(true)
  updatedAt     DateTime       @updatedAt
  departmentId  String
  announcements Announcement[]
  newsletters   Newsletter[]
  department    Department     @relation(fields: [departmentId], references: [id])
}

model Student {
  id                  String     @id @default(uuid())
  email               String     @unique
  password            String
  semester            Int
  createdAt           DateTime   @default(now())
  programId           String
  departmentId        String

  // 🔔 Push Notification Fields (NEW)
  expoPushToken       String?
  pushEnabled         Boolean    @default(false)
  pushTokenUpdatedAt  DateTime?

  department          Department @relation(fields: [departmentId], references: [id])
  program             Program    @relation(fields: [programId], references: [id])
}

model UploadedFile {
  id        String   @id @default(uuid())
  filePath  String
  mimeType  String
  size      Int
  url       String
  createdAt DateTime @default(now())

  announcementId String?
  announcement   Announcement? @relation(fields: [announcementId], references: [id])

  newsletterId String?
  newsletter   Newsletter? @relation(fields: [newsletterId], references: [id])
}

model Announcement {
  id           String    @id @default(uuid())
  title        String
  description  String
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?
  departmentId String
  facultyId    String
  priority     Priority
  programId    String
  semester     Int?
  updatedAt    DateTime  @updatedAt

  department Department @relation(fields: [departmentId], references: [id])
  faculty    Faculty    @relation(fields: [facultyId], references: [id])
  program    Program    @relation(fields: [programId], references: [id])

  files UploadedFile[]

  @@index([priority])
  @@index([expiresAt])
}

enum Priority {
  PINNED
  HIGH
  INFO
}

model Newsletter {
  id          String  @id @default(uuid())
  title       String
  description String?
  month       Int // 1–12
  year        Int

  programId    String? // null = global
  departmentId String? // null = global

  createdById String
  createdBy   Faculty @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files UploadedFile[]

  @@unique([month, year, programId, departmentId])
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}
