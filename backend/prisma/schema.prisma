generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =========================
// ENUMS
// =========================
enum Role {
  ADMIN
  STUDENT
}

enum AnnouncementCategory {
  ACADEMIC
  EXAM
  EVENT
  GENERAL
  EMERGENCY
}

// =========================
// MODELS
// =========================
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())

  announcements Announcement[]
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  description String
  category    AnnouncementCategory
  attachment  String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime?

  adminId String
  admin   User @relation(fields: [adminId], references: [id])

  @@index([category])
  @@index([expiresAt])
}

